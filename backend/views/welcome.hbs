<div class="welcome-container" style="text-align: center; margin-top: 100px; font-family: sans-serif;">
    <div style="max-width: 500px; margin: 0 auto; padding: 30px; border: 1px solid #e0e0e0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h1 style="color: #2c3e50; margin-bottom: 20px;"> Welcome to Clipper-1!</h1>
        
        <p style="color: #7f8c8d; font-size: 16px; line-height: 1.5;">
            Hej <strong>{{userEmail}}</strong>, {{t "welcome_p1"}}
        </p>
        
        <div style="background-color: #f8f9fa; border-left: 4px solid #f1c40f; padding: 15px; margin: 25px 0; text-align: left;">
            <p style="margin: 0; color: #d35400; font-weight: bold;">{{t "welcome_p2"}}</p>
            <p style="margin: 5px 0 0 0; color: #555; font-size: 14px;">
                {{t "welcome_p3"}}
            </p>
        </div>

        <p style="color: #95a5a6; font-size: 13px;">
            {{t "welcome_p4"}}
        </p>
        
        <a href="/logout/start" style="display: inline-block; margin-top: 15px; color: #e74c3c; text-decoration: none; font-size: 14px;">{{t "text_ref"}}</a>
    </div>
</div>